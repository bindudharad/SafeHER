# SafeHER Environment Configuration Template
# Copy to .env and fill in secure values before running in staging/production.
# NEVER commit real secrets, API keys, or private certificates.

# Runtime Environment ("development" | "staging" | "production")
SAFEHER_ENV=development

# Production Domain & TLS (Caddy ACME)
SAFEHER_DOMAIN=localhost
SAFEHER_ACME_EMAIL=ops@example.org
SAFEHER_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SAFEHER_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8

# Database & Encrypted Storage Paths
SAFEHER_DB_PATH=backend/safeher.db
SAFEHER_STORAGE_DIR=backend/storage/evidence
SAFEHER_KEY_DIR=backend/storage/keys

# Local Master Key Encryption Key (32-byte key in base64 or hex; required if KMS=local)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SAFEHER_KEK_B64=
# SAFEHER_KEK_HEX=

# Cloud KMS Configuration (BLOCKER 1)
# Provider: "local" | "aws" | "azure" | "gcp"
SAFEHER_KMS_PROVIDER=local
SAFEHER_KMS_KEY_ARN=
AWS_REGION=ap-south-1
# SAFEHER_KMS_ENDPOINT_URL=
# SAFEHER_KMS_TIMEOUT_SECONDS=5.0

# JWT Signing Secret (REQUIRED in production; use >= 32 random bytes)
SAFEHER_JWT_SECRET_KEY=

# Tampering Localization (BLOCKER 2)
# SAFEHER_TAMPERING_CHECKPOINT=models/trufor.pth.tar

# External Emergency SMS Gateway (BLOCKER 3)
# Provider: "unconfigured" | "twilio"
SAFEHER_SMS_PROVIDER=unconfigured
SAFEHER_SMS_SANDBOX_MODE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# SAFEHER_SMS_STATUS_CALLBACK_URL=
# SAFEHER_SMS_TIMEOUT_SECONDS=10.0

# Malware Scanning (ClamAV Network Daemon - BLOCKER 4A)
SAFEHER_ENABLE_CLAMAV=false
SAFEHER_REQUIRE_CLAMAV=false
SAFEHER_CLAMAV_HOST=127.0.0.1
SAFEHER_CLAMAV_PORT=3310
SAFEHER_CLAMAV_TIMEOUT_SECONDS=5.0
SAFEHER_CLAMAV_MAX_BYTES=26214400

# AI Model Policy (Model A, Model B, TruFor checkpoints are Non-Commercial / CC BY-NC 4.0)
# Set to "false" for commercial deployments until commercial-licensed weights are configured
SAFEHER_ENABLE_NONCOMMERCIAL_RESEARCH_MODELS=true
